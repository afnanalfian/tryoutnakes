APP_NAME="NakesPrep"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Lokal bisa pakai sqlite. Produksi: mysql (lihat docs/INSTALL-VPS.md)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tryoutnakes
# DB_USERNAME=tryoutnakes
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Brevo (SMTP relay gratis 300 email/hari)
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bynama.id"
MAIL_FROM_NAME="${APP_NAME}"

# Akun admin pertama (dipakai oleh seeder)
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@bynama.id
ADMIN_PASSWORD=NabilaCantik123!

# Opsional: kunci IndexNow (Bing/Yandex) — string acak 32 karakter
INDEXNOW_KEY=

VITE_APP_NAME="${APP_NAME}"
